LYZR_API_KEY=your_lyzr_api_key_here
LYZR_AGENT_ID=your_agent_id_here
LYZR_USER_ID=ocr-web-app
LYZR_BASE_URL=https://agent-prod.studio.lyzr.ai
CORS_ORIGINS=http://localhost:3000

# --- Outlook inbox automation (ocr-app/backend/outlook/) ---

# Azure AD app registration - see outlook-email-ingestion-plan/02-microsoft-portal-setup.md
GRAPH_TENANT_ID=your_tenant_id_here
GRAPH_CLIENT_ID=your_client_id_here
GRAPH_CLIENT_SECRET=your_client_secret_here

# Target mailbox (user id or UPN, restricted via Application Access Policy)
GRAPH_MAILBOX_USER_ID=invoices@yourcompany.com

GRAPH_BASE_URL=https://graph.microsoft.com/v1.0

# Whether processor.py writes lyzr_* status categories back onto emails in
# the mailbox (visible in Outlook as colored tags). Ingestion/OCR/DB writes
# are unaffected either way - this only toggles that cosmetic tagging.
# Defaults to true; set to "false" to turn it off.
OUTLOOK_UPDATE_CATEGORIES_FLAG=true

# Shared secret Lyzr Superflow's HTTP node sends on every call to
# /api/superflow/process (see outlook/superflow_router.py) - generate a
# random string, e.g. `openssl rand -base64 32`, and configure the SAME
# value as a Bearer token in Superflow's HTTP node.
SUPERFLOW_API_KEY=change-me-to-a-random-secret

# Always required - outlook/superflow_router.py enqueues every incoming
# message here, and outlook/worker.py (a background thread inside this
# same backend process - see main.py's lifespan) is what consumes it. AWS
# credentials/region come from the normal boto3 chain (env vars,
# ~/.aws/credentials, or the ECS task role in production) - not set here.
SQS_QUEUE_URL=https://sqs.<region>.amazonaws.com/<account-id>/outlook-notifications

# Where outlook/worker.py explicitly moves a message once it's exhausted
# DEAD_LETTER_RETRY_THRESHOLD retries (see queue_client.send_to_dlq) -
# must be a DIFFERENT queue than SQS_QUEUE_URL, with the main queue's
# redrive policy pointing at it too as a coarser fallback (see
# localstack/init-queues.sh).
SQS_DLQ_URL=https://sqs.<region>.amazonaws.com/<account-id>/outlook-notifications-dlq

# For local testing against a real SQS API without an AWS account: run
# `docker compose -f docker-compose.yml -f docker-compose.dev.yml up`
# (this brings up LocalStack + the worker automatically, and creates both
# queues - see localstack/init-queues.sh's own log output for the exact
# URLs) and use these values instead of the real-AWS ones:
#   SQS_QUEUE_URL=http://localstack:4566/000000000000/outlook-notifications
#   SQS_DLQ_URL=http://localstack:4566/000000000000/outlook-notifications-dlq
# docker-compose.dev.yml already points boto3 at LocalStack and supplies
# dummy AWS credentials for this - nothing else to configure.

# This module's own database (invoices ingested via the Outlook mailbox)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/outlook_invoices

# --- Multi-user auth (outlook/auth.py, outlook/auth_router.py) ---

# JWT signing secret for the app's own login (admin/viewer accounts) -
# replaces the old single-shared-password HTTP Basic Auth. Long random
# string, e.g. `openssl rand -base64 32`.
APP_JWT_SECRET=change-me-to-a-long-random-string

# There is no sign-up flow - the very first admin account is bootstrapped
# from these two vars by POST /api/seed, which the frontend's login page
# calls automatically on first load. Set a real password here; sign in once,
# then change it via Account.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=change-me-to-a-real-password
