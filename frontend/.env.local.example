# Only needed if you're running the frontend directly (`npm run dev`),
# outside Docker Compose, AND the backend isn't reachable at the default
# http://localhost:8000 (the code's own fallback covers the common case -
# see app/upload-test/page.tsx). Under Docker Compose, this is set in
# docker-compose.yml instead (pointing at the "backend" service name).
#
# Baked into the browser bundle at BUILD time, not read at runtime - see
# backend/README.md and misc/aws-request-detailed.txt for why that matters
# for a real deployment.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
