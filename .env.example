# Deploy-level flags, read by deploy.sh / deploy.ps1 - NOT read by the
# application code itself (contrast with backend/.env, which the FastAPI
# process reads directly). Copy this file to ".env" and adjust.

# Whether to bring up the Next.js frontend (the manual-upload UI +
# /outlook-invoices viewer) alongside the backend. true -> both start.
# false -> only db + backend start: a headless deployment that just runs
# the API and the Outlook mailbox automation, with no human-facing UI.
# Wired to docker-compose.yml's frontend service via the "ui" Compose
# profile - see deploy.sh/deploy.ps1.
ENABLE_UI_FLAG=false

# Baked into the frontend's browser bundle at build time (see
# frontend/Dockerfile and setup-guides/07-aws-deployment-env-changes.txt) -
# only used when ENABLE_UI_FLAG=true. Local/single-host default shown; set to
# your real public URL before building for anything else.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Everything else (LYZR_*, GRAPH_*, DATABASE_URL, INVOICES_AUTH_*,
# OUTLOOK_UPDATE_CATEGORIES, CORS_ORIGINS) lives in backend/.env - see
# backend/.env.example. docker-compose.yml reads that file directly for
# both the backend and frontend services, so it isn't duplicated here. ---
